{
  "name": "aura-mcp-server",
  "version": "1.1.1",
  "description": "AI Universal Runtime Architecture (AURA) - AI context management with intelligent model recommendations and standalone task management for any MCP-compatible IDE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aura-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "USER-GUIDE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "prepare": "npm run build",
    "test": "tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai",
    "ai-context",
    "ai-memory",
    "context-management",
    "task-management",
    "cursor",
    "cursor-ide",
    "claude",
    "claude-code",
    "vscode",
    "copilot",
    "github-copilot",
    "windsurf",
    "jetbrains",
    "ai-assistant",
    "session-persistence",
    "developer-tools"
  ],
  "author": "jun-Ai",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
